{
  "$defs": {
    "ActionType": {
      "enum": [
        "remove_vendor",
        "reduce_capacity",
        "add_capacity",
        "remove_roles",
        "stop_project",
        "start_project",
        "delay_project",
        "invest"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "metric": {
          "enum": [
            "annual_savings_usd",
            "net_value_usd",
            "revenue_impact_pct",
            "customer_impact_pct",
            "compliance_controls_broken",
            "stranded_workflows",
            "critical_systems_degraded",
            "max_capacity_loss_pct",
            "critical_coverage_pct"
          ],
          "title": "Metric",
          "type": "string"
        },
        "operator": {
          "enum": [
            "<=",
            ">=",
            "=="
          ],
          "title": "Operator",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "hard": {
          "title": "Hard",
          "type": "boolean"
        },
        "scope_entity_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Entity Id"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "metric",
        "operator",
        "threshold",
        "unit",
        "hard",
        "description"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "MitigationType": {
      "enum": [
        "reassign_owner",
        "document_runbook",
        "reassign_on_call",
        "add_replacement_feed",
        "resequence_project",
        "retain_capacity_temporarily"
      ],
      "title": "MitigationType",
      "type": "string"
    },
    "NeutraliserRef": {
      "additionalProperties": false,
      "properties": {
        "intervention_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionType"
            },
            {
              "$ref": "#/$defs/MitigationType"
            }
          ],
          "title": "Intervention Type"
        },
        "target_entity_id": {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Target Entity Id",
          "type": "string"
        }
      },
      "required": [
        "intervention_type",
        "target_entity_id"
      ],
      "title": "NeutraliserRef",
      "type": "object"
    },
    "Pressure": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^(?:pr_)[a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PressureKind"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "target_entity_id": {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Target Entity Id",
          "type": "string"
        },
        "start_day": {
          "default": 0,
          "minimum": 0,
          "title": "Start Day",
          "type": "integer"
        },
        "end_day": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Day"
        },
        "rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate"
        },
        "rate_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Range"
        },
        "step_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Pct"
        },
        "monthly_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monthly Probability"
        },
        "probability_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability Range"
        },
        "cost_per_event_usd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Per Event Usd"
        },
        "capacity_sensitivity": {
          "default": 0.0,
          "minimum": 0,
          "title": "Capacity Sensitivity",
          "type": "number"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "consequence_cost_usd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consequence Cost Usd"
        },
        "neutralised_by": {
          "items": {
            "$ref": "#/$defs/NeutraliserRef"
          },
          "title": "Neutralised By",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "target_entity_id",
        "description"
      ],
      "title": "Pressure",
      "type": "object"
    },
    "PressureKind": {
      "enum": [
        "cost_growth",
        "renewal_step",
        "hazard",
        "kpi_drift",
        "budget_ceiling",
        "deadline"
      ],
      "title": "PressureKind",
      "type": "string"
    },
    "RiskWeights": {
      "additionalProperties": false,
      "properties": {
        "financial": {
          "default": 25,
          "minimum": 0,
          "title": "Financial",
          "type": "number"
        },
        "capability_workflow": {
          "default": 25,
          "minimum": 0,
          "title": "Capability Workflow",
          "type": "number"
        },
        "customer_revenue": {
          "default": 20,
          "minimum": 0,
          "title": "Customer Revenue",
          "type": "number"
        },
        "compliance_control": {
          "default": 20,
          "minimum": 0,
          "title": "Compliance Control",
          "type": "number"
        },
        "execution_uncertainty": {
          "default": 10,
          "minimum": 0,
          "title": "Execution Uncertainty",
          "type": "number"
        }
      },
      "title": "RiskWeights",
      "type": "object"
    },
    "Sector": {
      "enum": [
        "technology_saas",
        "financial_services",
        "banking",
        "insurance",
        "healthcare",
        "pharma_life_sciences",
        "manufacturing",
        "retail_ecommerce",
        "telecom",
        "energy_utilities",
        "logistics_transport",
        "media_entertainment",
        "professional_services",
        "education",
        "public_sector",
        "nonprofit",
        "other"
      ],
      "title": "Sector",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 80,
      "pattern": "^(?:preset_)[a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "sector": {
      "$ref": "#/$defs/Sector"
    },
    "mandatory_frameworks": {
      "items": {
        "type": "string"
      },
      "title": "Mandatory Frameworks",
      "type": "array"
    },
    "default_constraints": {
      "items": {
        "$ref": "#/$defs/Constraint"
      },
      "title": "Default Constraints",
      "type": "array"
    },
    "risk_weights": {
      "anyOf": [
        {
          "$ref": "#/$defs/RiskWeights"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pressure_templates": {
      "items": {
        "$ref": "#/$defs/Pressure"
      },
      "title": "Pressure Templates",
      "type": "array"
    },
    "typical_departments": {
      "items": {
        "type": "string"
      },
      "title": "Typical Departments",
      "type": "array"
    }
  },
  "required": [
    "id",
    "sector"
  ],
  "title": "SectorPreset",
  "type": "object"
}
