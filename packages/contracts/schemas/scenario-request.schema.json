{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canary-pact.local/schemas/scenario-request.schema.json",
  "title": "ScenarioRequest",
  "type": "object",
  "required": ["title", "objective", "remove_entity_ids", "savings_target", "constraints"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "remove_entity_ids": { "type": "array", "items": { "type": "string" } },
    "savings_target": { "type": "number", "minimum": 0 },
    "constraints": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}

