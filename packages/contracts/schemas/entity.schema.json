{
  "$defs": {
    "Criticality": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Criticality",
      "type": "string"
    },
    "EntityType": {
      "enum": [
        "department",
        "person_token",
        "role",
        "knowledge_asset",
        "system",
        "vendor",
        "project",
        "workflow",
        "control",
        "kpi",
        "customer_segment",
        "dataset"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "general",
        "finance",
        "hr",
        "customer",
        "security"
      ],
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/EntityType"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "department_id": {
      "anyOf": [
        {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Department Id"
    },
    "criticality": {
      "$ref": "#/$defs/Criticality",
      "default": "medium"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity",
      "default": "general"
    },
    "annual_cost_usd": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Annual Cost Usd"
    },
    "one_time_exit_cost_usd": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "One Time Exit Cost Usd"
    },
    "migration_cost_usd": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Migration Cost Usd"
    },
    "capacity_fte": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capacity Fte"
    },
    "min_qualified_owners": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Qualified Owners"
    },
    "documented_pct": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Documented Pct"
    },
    "failure_cost_per_day_usd": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Cost Per Day Usd"
    },
    "customer_facing": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Customer Facing"
    },
    "completion_pct": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completion Pct"
    },
    "remaining_cost_usd": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remaining Cost Usd"
    },
    "expected_completion_day": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Completion Day"
    },
    "retires_entity_ids": {
      "items": {
        "maxLength": 80,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Retires Entity Ids",
      "type": "array"
    },
    "role_id": {
      "anyOf": [
        {
          "maxLength": 80,
          "pattern": "^(?:role_)[a-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Role Id"
    },
    "kpi_baseline": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kpi Baseline"
    },
    "kpi_unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kpi Unit"
    },
    "higher_is_better": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Higher Is Better"
    },
    "mandatory": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mandatory"
    },
    "framework": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Framework"
    },
    "arr_usd": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arr Usd"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 80,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "geographies": {
      "items": {
        "type": "string"
      },
      "title": "Geographies",
      "type": "array"
    },
    "history_years": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "History Years"
    },
    "freshness_days": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Freshness Days"
    },
    "accuracy": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accuracy"
    },
    "permitted_uses": {
      "items": {
        "type": "string"
      },
      "title": "Permitted Uses",
      "type": "array"
    },
    "retains_history_after_termination": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retains History After Termination"
    },
    "attribute_group": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attribute Group"
    },
    "time_to_train_days": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time To Train Days"
    },
    "replacement_cost_usd": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replacement Cost Usd"
    },
    "exception_documented_pct": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exception Documented Pct"
    },
    "automation_pct": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Automation Pct"
    },
    "max_downtime_days": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Downtime Days"
    },
    "aliases": {
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    }
  },
  "required": [
    "id",
    "type",
    "name"
  ],
  "title": "Entity",
  "type": "object"
}
