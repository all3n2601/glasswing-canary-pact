        },
        "p90_net_value_usd": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P90 Net Value Usd"
        }
      },
      "required": [
        "gross_savings_usd",
        "transition_cost_usd",
        "added_cost_usd",
        "rebound_cost_usd",
        "expected_business_loss_usd",
        "pressure_cost_usd",
        "avoided_failure_cost_usd",
        "net_value_usd"
      ],
