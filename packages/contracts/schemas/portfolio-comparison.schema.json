    },
    "recommended": {
      "anyOf": [
        {
          "$ref": "#/$defs/Portfolio"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "alternatives": {
      "items": {
        "$ref": "#/$defs/Portfolio"
      },
      "title": "Alternatives",
      "type": "array"
    }
  },
