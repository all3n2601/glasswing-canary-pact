{
  "additionalProperties": false,
  "properties": {
    "email": {
      "maxLength": 254,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "title": "Email",
      "type": "string"
    },
    "password": {
      "maxLength": 256,
      "minLength": 8,
      "title": "Password",
      "type": "string"
    },
    "display_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    }
  },
  "required": [
    "email",
    "password",
    "display_name"
  ],
  "title": "SignupRequest",
  "type": "object"
}
