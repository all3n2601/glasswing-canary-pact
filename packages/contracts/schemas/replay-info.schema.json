{
  "additionalProperties": false,
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "decision_id": {
      "anyOf": [
        {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Id"
    },
    "event_count": {
      "minimum": 0,
      "title": "Event Count",
      "type": "integer"
    }
  },
  "required": [
    "name",
    "event_count"
  ],
  "title": "ReplayInfo",
  "type": "object"
}
