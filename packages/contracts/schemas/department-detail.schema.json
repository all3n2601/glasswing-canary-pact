      "title": "DocumentStatus",
      "type": "string"
    },
    "DocumentType": {
      "enum": [
        "contract",
        "policy",
        "runbook",
        "sop",
        "architecture_note",
        "org_chart",
        "budget_report",
        "financial_forecast",
        "kpi_report",
        "incident_report",
        "audit_report",
        "workflow_map",
        "knowledge_matrix",
        "meeting_minutes",
        "strategy_memo",
        "other"
