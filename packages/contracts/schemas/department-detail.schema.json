          "type": "string"
        },
        "target": {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Target",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/Relation"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "channel_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChannelKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "strength": {
          "maximum": 1,
          "minimum": 0,
          "title": "Strength",
          "type": "number"
        },
        "strength_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strength Range"
        },
        "substitutability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Substitutability",
          "type": "number"
        },
        "lag_days": {
          "minimum": 0,
          "title": "Lag Days",
          "type": "integer"
        },
        "criticality": {
          "$ref": "#/$defs/Criticality"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "extraction_method": {
          "anyOf": [
            {
              "enum": [
                "seeded",
                "keyword",
                "zero_shot",
                "canary",
                "agent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Method"
        },
        "last_validated": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Validated"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "relation",
        "strength",
        "substitutability",
        "lag_days",
        "criticality",
        "confidence"
      ],
      "title": "Edge",
      "type": "object"
    },
