        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/StrengthCategory"
        },
        "level": {
          "maximum": 5,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "supports_entity_ids": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Supports Entity Ids",
          "type": "array"
        },
        "key_role_ids": {
          "items": {
            "maxLength": 80,
            "pattern": "^(?:role_)[a-z0-9_]*$",
