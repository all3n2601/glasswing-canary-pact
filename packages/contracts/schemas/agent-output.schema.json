{
  "$defs": {
    "AgentQuestion": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "why_it_matters": {
          "title": "Why It Matters",
          "type": "string"
        },
        "entity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "why_it_matters"
      ],
      "title": "AgentQuestion",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "increase",
        "decrease",
        "no_change"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Finding": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "entity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        },
        "severity": {
          "maximum": 5,
          "minimum": 1,
          "title": "Severity",
          "type": "integer"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "text",
        "severity"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FutureView": {
      "properties": {
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "failure_modes": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Failure Modes",
          "type": "array"
        },
        "edge_cases": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Edge Cases",
          "type": "array"
        },
        "proposed_impacts": {
          "items": {
            "$ref": "#/$defs/ProposedImpact"
          },
          "title": "Proposed Impacts",
          "type": "array"
        }
      },
      "required": [
        "summary"
      ],
      "title": "FutureView",
      "type": "object"
    },
    "ImpactCategory": {
      "enum": [
        "ownership",
        "technical",
        "operational",
        "business",
        "compliance",
        "financial"
      ],
      "title": "ImpactCategory",
      "type": "string"
    },
    "ImpactLevel": {
      "enum": [
        "direct",
        "dependent",
        "second_order",
        "delayed",
        "feedback"
      ],
      "title": "ImpactLevel",
      "type": "string"
    },
    "Objection": {
      "properties": {
        "target_ref": {
          "title": "Target Ref",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "severity": {
          "maximum": 5,
          "minimum": 1,
          "title": "Severity",
          "type": "integer"
        }
      },
      "required": [
        "target_ref",
        "text",
        "severity"
      ],
      "title": "Objection",
      "type": "object"
    },
    "Polarity": {
      "enum": [
        "benefit",
        "harm"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "ProposedDependency": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/Relation"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "source",
        "target",
        "relation",
        "rationale",
        "confidence"
      ],
      "title": "ProposedDependency",
      "type": "object"
    },
    "ProposedImpact": {
      "properties": {
        "affected_entity": {
          "title": "Affected Entity",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "polarity": {
          "$ref": "#/$defs/Polarity"
        },
        "category": {
          "$ref": "#/$defs/ImpactCategory"
        },
        "level": {
          "$ref": "#/$defs/ImpactLevel"
        },
        "estimated_magnitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Magnitude"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "first_effect_day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Effect Day"
        },
        "severity": {
          "maximum": 5,
          "minimum": 1,
          "title": "Severity",
          "type": "integer"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "dependency_path": {
          "items": {
            "type": "string"
          },
          "title": "Dependency Path",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "affected_entity",
        "metric",
        "direction",
        "polarity",
        "category",
        "level",
        "severity",
        "rationale",
        "confidence"
      ],
      "title": "ProposedImpact",
      "type": "object"
    },
    "Relation": {
      "enum": [
        "OWNS",
        "BACKS_UP",
        "KNOWS",
        "MAINTAINS",
        "RUNS",
        "PROVIDES",
        "CONSUMES",
        "DEPENDS_ON",
        "SUPPORTS",
        "FUNDS",
        "CONTROLS",
        "CONTRIBUTES_TO",
        "SUBSTITUTES_FOR",
        "FLOWS_TO"
      ],
      "title": "Relation",
      "type": "string"
    }
  },
  "properties": {
    "affected_entities": {
      "items": {
        "type": "string"
      },
      "title": "Affected Entities",
      "type": "array"
    },
    "act_now_view": {
      "$ref": "#/$defs/FutureView"
    },
    "inaction_view": {
      "$ref": "#/$defs/FutureView"
    },
    "proposed_dependencies": {
      "items": {
        "$ref": "#/$defs/ProposedDependency"
      },
      "title": "Proposed Dependencies",
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/AgentQuestion"
      },
      "title": "Questions",
      "type": "array"
    },
    "objections": {
      "items": {
        "$ref": "#/$defs/Objection"
      },
      "title": "Objections",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "confidence": {
      "title": "Confidence",
      "type": "number"
    }
  },
  "required": [
    "act_now_view",
    "inaction_view",
    "confidence"
  ],
  "title": "AgentOutput",
  "type": "object"
}
