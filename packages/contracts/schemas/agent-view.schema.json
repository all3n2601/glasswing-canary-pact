{
  "$defs": {
    "ActionType": {
      "enum": [
        "remove_vendor",
        "reduce_capacity",
        "add_capacity",
        "remove_roles",
        "stop_project",
        "start_project",
        "delay_project",
        "invest"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "BusinessModel": {
      "enum": [
        "b2b",
        "b2c",
        "b2b2c",
        "marketplace",
        "public_service",
        "mixed"
      ],
      "title": "BusinessModel",
      "type": "string"
    },
    "ChannelKind": {
      "enum": [
        "constraint",
        "budget",
        "capability",
        "signal",
        "value"
      ],
      "title": "ChannelKind",
      "type": "string"
    },
    "Criticality": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Criticality",
      "type": "string"
    },
    "DepartmentBudget": {
      "additionalProperties": false,
      "properties": {
        "annual_budget_usd": {
          "minimum": 0,
          "title": "Annual Budget Usd",
          "type": "integer"
        },
        "spent_ytd_usd": {
          "minimum": 0,
          "title": "Spent Ytd Usd",
          "type": "integer"
        },
        "fixed_cost_pct": {
          "maximum": 1,
          "minimum": 0,
          "title": "Fixed Cost Pct",
          "type": "number"
        },
        "budget_owner_role_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^(?:role_)[a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Owner Role Id"
        }
      },
      "required": [
        "annual_budget_usd",
        "spent_ytd_usd",
        "fixed_cost_pct"
      ],
      "title": "DepartmentBudget",
      "type": "object"
    },
    "DepartmentGap": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^(?:gap_)[a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/StrengthCategory"
        },
        "severity": {
          "maximum": 5,
          "minimum": 1,
          "title": "Severity",
          "type": "integer"
        },
        "affected_entity_ids": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Affected Entity Ids",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "severity"
      ],
      "title": "DepartmentGap",
      "type": "object"
    },
    "DepartmentProfile": {
      "additionalProperties": false,
      "properties": {
        "department_id": {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Department Id",
          "type": "string"
        },
        "mission": {
          "title": "Mission",
          "type": "string"
        },
        "head_role_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^(?:role_)[a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Head Role Id"
        },
        "agent_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "staffing": {
          "$ref": "#/$defs/StaffingStrength"
        },
        "budget": {
          "$ref": "#/$defs/DepartmentBudget"
        },
        "strengths": {
          "items": {
            "$ref": "#/$defs/DepartmentStrength"
          },
          "minItems": 1,
          "title": "Strengths",
          "type": "array"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/DepartmentGap"
          },
          "title": "Gaps",
          "type": "array"
        },
        "maturity_level": {
          "maximum": 5,
          "minimum": 1,
          "title": "Maturity Level",
          "type": "integer"
        },
        "owned_entity_ids": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Owned Entity Ids",
          "type": "array"
        },
        "critical_workflow_ids": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Critical Workflow Ids",
          "type": "array"
        },
        "kpi_ids": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Kpi Ids",
          "type": "array"
        },
        "document_ids": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Document Ids",
          "type": "array"
        },
        "documentation_coverage": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Documentation Coverage",
          "type": "number"
        }
      },
      "required": [
        "department_id",
        "mission",
        "staffing",
        "budget",
        "strengths",
        "maturity_level"
      ],
      "title": "DepartmentProfile",
      "type": "object"
    },
    "DepartmentStrength": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^(?:str_)[a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/StrengthCategory"
        },
        "level": {
          "maximum": 5,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "supports_entity_ids": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Supports Entity Ids",
          "type": "array"
        },
        "key_role_ids": {
          "items": {
            "maxLength": 80,
            "pattern": "^(?:role_)[a-z0-9_]*$",
            "type": "string"
          },
          "title": "Key Role Ids",
          "type": "array"
        },
        "concentration": {
          "maximum": 1,
          "minimum": 0,
          "title": "Concentration",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "level",
        "concentration"
      ],
      "title": "DepartmentStrength",
      "type": "object"
    },
    "DepartmentSummary": {
      "additionalProperties": false,
      "properties": {
        "department_id": {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Department Id",
          "type": "string"
        },
        "mission": {
          "title": "Mission",
          "type": "string"
        },
        "strength_names": {
          "items": {
            "type": "string"
          },
          "title": "Strength Names",
          "type": "array"
        },
        "staffing": {
          "$ref": "#/$defs/StaffingStrength"
        }
      },
      "required": [
        "department_id",
        "mission",
        "staffing"
      ],
      "title": "DepartmentSummary",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^(?:doc_)[a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "doc_type": {
          "$ref": "#/$defs/DocumentType"
        },
        "department_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Department Id"
        },
        "owner_role_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^(?:role_)[a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Role Id"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "mime_type": {
          "title": "Mime Type",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DocumentStatus"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "last_reviewed": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Reviewed"
        },
        "review_cycle_days": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Cycle Days"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity",
          "default": "general"
        },
        "covers_entity_ids": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Covers Entity Ids",
          "type": "array"
        },
        "framework_refs": {
          "items": {
            "type": "string"
          },
          "title": "Framework Refs",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "page_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Count"
        },
        "checksum_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum Sha256"
        },
        "synthetic": {
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "ingested": {
          "default": false,
          "title": "Ingested",
          "type": "boolean"
        },
        "uploaded_at": {
          "format": "date-time",
          "title": "Uploaded At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "doc_type",
        "uri",
        "mime_type",
        "status",
        "summary",
        "uploaded_at"
      ],
      "title": "Document",
      "type": "object"
    },
    "DocumentStatus": {
      "enum": [
        "current",
        "outdated",
        "draft",
        "archived"
      ],
      "title": "DocumentStatus",
      "type": "string"
    },
    "DocumentType": {
      "enum": [
        "contract",
        "policy",
        "runbook",
        "sop",
        "architecture_note",
        "org_chart",
        "budget_report",
        "financial_forecast",
        "kpi_report",
        "incident_report",
        "audit_report",
        "workflow_map",
        "knowledge_matrix",
        "meeting_minutes",
        "strategy_memo",
        "other"
      ],
      "title": "DocumentType",
      "type": "string"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^(?:ch_|e_)[a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Target",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/Relation"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "channel_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChannelKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "strength": {
          "maximum": 1,
          "minimum": 0,
          "title": "Strength",
          "type": "number"
        },
        "strength_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strength Range"
        },
        "substitutability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Substitutability",
          "type": "number"
        },
        "lag_days": {
          "minimum": 0,
          "title": "Lag Days",
          "type": "integer"
        },
        "criticality": {
          "$ref": "#/$defs/Criticality"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "relation",
        "strength",
        "substitutability",
        "lag_days",
        "criticality",
        "confidence"
      ],
      "title": "Edge",
      "type": "object"
    },
