{
  "$defs": {
    "BusinessModel": {
      "enum": [
        "b2b",
        "b2c",
        "b2b2c",
        "marketplace",
        "public_service",
        "mixed"
      ],
      "title": "BusinessModel",
      "type": "string"
    },
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "metric": {
          "enum": [
            "annual_savings_usd",
            "net_value_usd",
            "revenue_impact_pct",
            "customer_impact_pct",
            "compliance_controls_broken",
            "stranded_workflows",
            "critical_systems_degraded",
            "max_capacity_loss_pct",
            "critical_coverage_pct"
          ],
          "title": "Metric",
          "type": "string"
        },
        "operator": {
          "enum": [
            "<=",
            ">=",
            "=="
          ],
          "title": "Operator",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "hard": {
          "title": "Hard",
          "type": "boolean"
        },
        "scope_entity_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Entity Id"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "metric",
        "operator",
        "threshold",
        "unit",
        "hard",
        "description"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "DocumentType": {
      "enum": [
        "contract",
        "policy",
        "runbook",
        "sop",
        "architecture_note",
        "org_chart",
        "budget_report",
        "financial_forecast",
        "kpi_report",
        "incident_report",
        "audit_report",
        "workflow_map",
        "knowledge_matrix",
        "meeting_minutes",
        "strategy_memo",
        "other"
      ],
      "title": "DocumentType",
      "type": "string"
    },
    "Future": {
      "enum": [
        "act_now",
        "inaction",
        "delay",
        "alternative"
      ],
      "title": "Future",
      "type": "string"
    },
    "Organization": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^(?:org_)[a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "legal_name": {
          "title": "Legal Name",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "sector": {
          "$ref": "#/$defs/Sector"
        },
        "sub_sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sub Sector"
        },
        "secondary_sectors": {
          "items": {
            "$ref": "#/$defs/Sector"
          },
          "title": "Secondary Sectors",
          "type": "array"
        },
        "business_model": {
          "$ref": "#/$defs/BusinessModel"
        },
        "size_band": {
          "$ref": "#/$defs/SizeBand"
        },
        "headquarters_country": {
          "title": "Headquarters Country",
          "type": "string"
        },
        "operating_regions": {
          "items": {
            "type": "string"
          },
          "title": "Operating Regions",
          "type": "array"
        },
        "annual_revenue_usd": {
          "minimum": 0,
          "title": "Annual Revenue Usd",
          "type": "integer"
        },
        "total_annual_budget_usd": {
          "minimum": 0,
          "title": "Total Annual Budget Usd",
          "type": "integer"
        },
        "total_headcount_fte": {
          "minimum": 0,
          "title": "Total Headcount Fte",
          "type": "number"
        },
        "fiscal_year_start_month": {
          "maximum": 12,
          "minimum": 1,
          "title": "Fiscal Year Start Month",
          "type": "integer"
        },
        "regulatory_frameworks": {
          "items": {
            "type": "string"
          },
          "title": "Regulatory Frameworks",
          "type": "array"
        },
        "strategic_priorities": {
          "items": {
            "$ref": "#/$defs/StrategicPriority"
          },
          "title": "Strategic Priorities",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "legal_name",
        "display_name",
        "sector",
        "business_model",
        "size_band",
        "headquarters_country",
        "annual_revenue_usd",
        "total_annual_budget_usd",
        "total_headcount_fte",
        "fiscal_year_start_month",
        "description"
      ],
      "title": "Organization",
      "type": "object"
    },
    "OrganizationDepartmentSummary": {
      "additionalProperties": false,
      "properties": {
        "department_id": {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Department Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "mission": {
          "title": "Mission",
          "type": "string"
        },
        "actual_fte": {
          "minimum": 0,
          "title": "Actual Fte",
          "type": "number"
        },
        "annual_budget_usd": {
          "minimum": 0,
          "title": "Annual Budget Usd",
          "type": "integer"
        },
        "utilisation": {
          "maximum": 1.5,
          "minimum": 0,
          "title": "Utilisation",
          "type": "number"
        },
        "maturity_level": {
          "maximum": 5,
          "minimum": 1,
          "title": "Maturity Level",
          "type": "integer"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        },
        "agent_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        }
      },
      "required": [
        "department_id",
        "name",
        "mission",
        "actual_fte",
        "annual_budget_usd",
        "utilisation",
        "maturity_level",
        "enabled"
      ],
      "title": "OrganizationDepartmentSummary",
      "type": "object"
    },
    "OrganizationSettings": {
      "additionalProperties": false,
      "properties": {
        "settings_id": {
          "default": "set_default",
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Settings Id",
          "type": "string"
        },
        "organization_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization Id"
        },
        "settings_version": {
          "default": 1,
          "minimum": 1,
          "title": "Settings Version",
          "type": "integer"
        },
        "updated_by": {
          "default": "system",
          "title": "Updated By",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "display_currency": {
          "default": "USD",
          "title": "Display Currency",
          "type": "string"
        },
        "money_display_scale": {
          "default": "auto",
          "enum": [
            "auto",
            "K",
            "M",
            "B"
          ],
          "title": "Money Display Scale",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "title": "Timezone",
          "type": "string"
        },
        "locale": {
          "default": "en-US",
          "title": "Locale",
          "type": "string"
        },
        "default_horizon_days": {
          "default": 365,
          "exclusiveMinimum": 0,
          "title": "Default Horizon Days",
          "type": "integer"
        },
        "default_futures": {
          "items": {
            "$ref": "#/$defs/Future"
          },
          "title": "Default Futures",
          "type": "array"
        },
        "default_delay_days": {
          "default": 90,
          "minimum": 0,
          "title": "Default Delay Days",
          "type": "integer"
        },
        "mc_samples": {
          "default": 1000,
          "maximum": 5000,
          "minimum": 200,
          "title": "Mc Samples",
          "type": "integer"
        },
        "default_seed": {
          "default": 42,
          "title": "Default Seed",
          "type": "integer"
        },
        "propagation_max_hops": {
          "default": 4,
          "maximum": 6,
          "minimum": 1,
          "title": "Propagation Max Hops",
          "type": "integer"
        },
        "min_impact_threshold": {
          "default": 0.02,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Impact Threshold",
          "type": "number"
        },
        "risk_appetite": {
          "$ref": "#/$defs/RiskAppetite",
          "default": "balanced"
        },
        "risk_level_thresholds": {
          "$ref": "#/$defs/RiskLevelThresholds"
        },
        "risk_weights": {
          "$ref": "#/$defs/RiskWeights"
        },
        "optimizer_objective": {
          "default": "max_net_value",
          "enum": [
            "max_net_value",
            "min_risk",
            "balanced"
          ],
          "title": "Optimizer Objective",
          "type": "string"
        },
        "default_constraints": {
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "title": "Default Constraints",
          "type": "array"
        },
        "always_protected_entity_ids": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Always Protected Entity Ids",
          "type": "array"
        },
        "require_human_approval": {
          "const": true,
          "default": true,
          "title": "Require Human Approval",
          "type": "boolean"
        },
        "anonymize_people": {
          "const": true,
          "default": true,
          "title": "Anonymize People",
          "type": "boolean"
        },
        "enabled_agent_ids": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Enabled Agent Ids",
          "type": "array"
        },
        "llm_mode": {
          "const": "live",
          "default": "live",
          "title": "Llm Mode",
          "type": "string"
        },
        "model_id_strong": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id Strong"
        },
        "model_id_fast": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id Fast"
        },
        "max_tool_calls": {
          "default": 3,
          "maximum": 5,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "temperature": {
          "default": 0.4,
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "agent_timeout_seconds": {
          "default": 45,
          "exclusiveMinimum": 0,
          "title": "Agent Timeout Seconds",
          "type": "integer"
        },
        "doc_staleness_days": {
          "default": 365,
          "exclusiveMinimum": 0,
          "title": "Doc Staleness Days",
          "type": "integer"
        },
        "required_doc_types_per_workflow": {
          "items": {
            "$ref": "#/$defs/DocumentType"
          },
          "title": "Required Doc Types Per Workflow",
          "type": "array"
        },
        "sector_preset_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector Preset Id"
        }
      },
      "title": "OrganizationSettings",
      "type": "object"
    },
    "RiskAppetite": {
      "enum": [
        "conservative",
        "balanced",
        "aggressive"
      ],
      "title": "RiskAppetite",
      "type": "string"
    },
    "RiskLevelThresholds": {
      "additionalProperties": false,
      "properties": {
        "medium": {
          "default": 25,
          "title": "Medium",
          "type": "number"
        },
        "high": {
          "default": 50,
          "title": "High",
          "type": "number"
        },
        "critical": {
          "default": 75,
          "title": "Critical",
          "type": "number"
        }
      },
      "title": "RiskLevelThresholds",
      "type": "object"
    },
    "RiskWeights": {
      "additionalProperties": false,
      "properties": {
        "financial": {
          "default": 25,
          "minimum": 0,
          "title": "Financial",
          "type": "number"
        },
        "capability_workflow": {
          "default": 25,
          "minimum": 0,
          "title": "Capability Workflow",
          "type": "number"
        },
        "customer_revenue": {
          "default": 20,
          "minimum": 0,
          "title": "Customer Revenue",
          "type": "number"
        },
        "compliance_control": {
          "default": 20,
          "minimum": 0,
          "title": "Compliance Control",
          "type": "number"
        },
        "execution_uncertainty": {
          "default": 10,
          "minimum": 0,
          "title": "Execution Uncertainty",
          "type": "number"
        }
      },
      "title": "RiskWeights",
      "type": "object"
    },
    "Sector": {
      "enum": [
        "technology_saas",
        "financial_services",
        "banking",
        "insurance",
        "healthcare",
        "pharma_life_sciences",
        "manufacturing",
        "retail_ecommerce",
        "telecom",
        "energy_utilities",
        "logistics_transport",
        "media_entertainment",
        "professional_services",
        "education",
        "public_sector",
        "nonprofit",
        "other"
      ],
      "title": "Sector",
      "type": "string"
    },
    "SizeBand": {
      "enum": [
        "startup",
        "smb",
        "mid_market",
        "enterprise",
        "large_enterprise"
      ],
      "title": "SizeBand",
      "type": "string"
    },
    "StrategicPriority": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "kpi_ids": {
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Kpi Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "rank"
      ],
      "title": "StrategicPriority",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "twin_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Twin Version"
    },
    "schema_version": {
      "default": "2.1.1",
      "enum": [
        "2.1.0",
        "2.1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "organization": {
      "$ref": "#/$defs/Organization"
    },
    "departments": {
      "items": {
        "$ref": "#/$defs/OrganizationDepartmentSummary"
      },
      "title": "Departments",
      "type": "array"
    },
    "settings": {
      "$ref": "#/$defs/OrganizationSettings"
    }
  },
  "required": [
    "organization",
    "departments",
    "settings"
  ],
  "title": "OrganizationProfileView",
  "type": "object"
}
