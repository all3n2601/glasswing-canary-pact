{
  "$defs": {
    "ClaimStatus": {
      "enum": [
        "computed",
        "validated",
        "hypothesis",
        "rejected"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "Direction": {
      "enum": [
        "increase",
        "decrease",
        "no_change"
      ],
      "title": "Direction",
      "type": "string"
    },
    "ImpactCategory": {
      "enum": [
        "ownership",
        "technical",
        "operational",
        "business",
        "compliance",
        "financial"
      ],
      "title": "ImpactCategory",
      "type": "string"
    },
    "ImpactLevel": {
      "enum": [
        "direct",
        "dependent",
        "second_order",
        "delayed",
        "feedback"
      ],
      "title": "ImpactLevel",
      "type": "string"
    },
    "Origin": {
      "enum": [
        "engine",
        "agent",
        "challenger",
        "user"
      ],
      "title": "Origin",
      "type": "string"
    },
    "Polarity": {
      "enum": [
        "benefit",
        "harm"
      ],
      "title": "Polarity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "impact_id": {
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Impact Id",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Decision Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "source_entity": {
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Source Entity",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "intervention",
        "pressure"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_ref": {
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Source Ref",
      "type": "string"
    },
    "affected_entity": {
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Affected Entity",
      "type": "string"
    },
    "affected_department": {
      "anyOf": [
        {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Affected Department"
    },
    "level": {
      "$ref": "#/$defs/ImpactLevel"
    },
    "category": {
      "$ref": "#/$defs/ImpactCategory"
    },
    "polarity": {
      "$ref": "#/$defs/Polarity"
    },
    "direction": {
      "$ref": "#/$defs/Direction"
    },
    "metric": {
      "title": "Metric",
      "type": "string"
    },
    "magnitude": {
      "title": "Magnitude",
      "type": "number"
    },
    "unit": {
      "title": "Unit",
      "type": "string"
    },
    "value_usd": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value Usd"
    },
    "severity": {
      "maximum": 5,
      "minimum": 1,
      "title": "Severity",
      "type": "integer"
    },
    "first_effect_day": {
      "minimum": 0,
      "title": "First Effect Day",
      "type": "integer"
    },
    "peak_effect_day": {
      "minimum": 0,
      "title": "Peak Effect Day",
      "type": "integer"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "dependency_path": {
      "items": {
        "maxLength": 80,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Dependency Path",
      "type": "array"
    },
    "edge_path": {
      "items": {
        "maxLength": 80,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Edge Path",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 80,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "constraint_refs": {
      "items": {
        "maxLength": 80,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Constraint Refs",
      "type": "array"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "status": {
      "$ref": "#/$defs/ClaimStatus"
    }
  },
  "required": [
    "impact_id",
    "decision_id",
    "scenario_id",
    "source_entity",
    "source_kind",
    "source_ref",
    "affected_entity",
    "level",
    "category",
    "polarity",
    "direction",
    "metric",
    "magnitude",
    "unit",
    "severity",
    "first_effect_day",
    "peak_effect_day",
    "confidence",
    "origin",
    "status"
  ],
  "title": "Impact",
  "type": "object"
}
