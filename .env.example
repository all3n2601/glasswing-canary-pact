# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Sciforium hackathon compute (OpenAI-compatible). Key handed out at Saturday compute setup.
SCIFORIUM_API_KEY=
SCIFORIUM_BASE_URL=https://api.sciforium.com/v1
# Model strings must match EXACTLY; deployment id comes from compute setup.
MODEL_STRONG=/deployments/<DEPLOYMENT_ID>/deepseek-ai/DeepSeek-V4.1-Flash
MODEL_FAST=/deployments/<DEPLOYMENT_ID>/deepseek-ai/DeepSeek-V4.1-Flash
# Structured output: auto tries json_schema then function_calling.
CANARY_STRUCTURED_OUTPUT=auto
# Engine simulate mode: full (default) falls back to expected value (p10 = p50 = p90) until Monte Carlo lands; quick reports point values.
CANARY_SIM_MODE=full
# Engine and twin: real (default) or stub (offline tests and evals); blank TWIN_IMPL follows ENGINE_IMPL.
ENGINE_IMPL=
TWIN_IMPL=
# Default agent mode (mock, replay or live); blank means live when CANARY_ALLOW_LIVE=true, else replay.
CANARY_LLM_MODE=

# Used by the OpenAI client as the model key only when SCIFORIUM_API_KEY is blank.
OPENAI_API_KEY=

# App
NEXT_PUBLIC_API_URL=http://localhost:8000
# Blank uses files and SQLite under runs/. Supabase direct hosts are IPv6-only, so use the session pooler string: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Postgres schema for the canary_ tables (default canary; keep it out of public so the Supabase Data API cannot see it).
CANARY_DB_SCHEMA=

# Auth
# Token signing secret; if blank a random one is used and tokens reset on every restart.
CANARY_AUTH_SECRET=
# Email for a demo approver created on startup when both demo values are set.
CANARY_DEMO_APPROVER_EMAIL=
# Password for that demo approver (at least 8 characters).
CANARY_DEMO_APPROVER_PASSWORD=
# Set to true to allow POST /decisions?llm_mode=live (real model calls); anything else returns 403.
CANARY_ALLOW_LIVE=
