# Copy to .env and fill in. NEVER commit .env (it is gitignored). Secrets stay blank here.

# Live model access (Sciforium, OpenAI-compatible)
# Sciforium API key handed out at compute setup.
SCIFORIUM_API_KEY=
# OpenAI-compatible base URL for the Sciforium deployment.
SCIFORIUM_BASE_URL=https://api.sciforium.com/v1
# Optional full chat-completions URL; when set it replaces SCIFORIUM_BASE_URL.
SCIFORIUM_API_URL=
# Used by the OpenAI client as the model key only when SCIFORIUM_API_KEY is blank.
OPENAI_API_KEY=
# Model id for department agents and intake (must match the deployment string exactly).
MODEL_STRONG=/deployments/<DEPLOYMENT_ID>/deepseek-ai/DeepSeek-V4.1-Flash
# Model id for agents that run on the fast model.
MODEL_FAST=/deployments/<DEPLOYMENT_ID>/deepseek-ai/DeepSeek-V4.1-Flash
# Overrides MODEL_STRONG when set.
CANARY_MODEL_STRONG=
# Overrides MODEL_FAST when set.
CANARY_MODEL_FAST=
# Fallback model id when neither the strong nor the fast model is set.
SCIFORIUM_MODEL=
# Sampling temperature for live calls; blank uses the organization settings default.
SCIFORIUM_TEMPERATURE=
# Per-call timeout in seconds for live calls; blank uses the organization settings default.
SCIFORIUM_TIMEOUT_SECONDS=
# Structured output: auto (tries json_schema then function_calling), json_schema or function_calling.
CANARY_STRUCTURED_OUTPUT=auto
# DeepSeek thinking for live agents: on (default, more accurate) or off (about 2x faster).
CANARY_LLM_THINKING=on
# DeepSeek thinking for the challenger only: on or off; blank follows CANARY_LLM_THINKING.
CANARY_CHALLENGER_THINKING=
# Set to true to allow decision runs, intake and evals to call live agents (paid model calls).
CANARY_ALLOW_LIVE=

# Engine, twin and agent context
# Engine simulate mode: full (default) falls back to expected value (p10 = p50 = p90) until Monte Carlo lands; quick reports point values.
CANARY_SIM_MODE=full
# Engine implementation: real (default) or stub (offline tests and evals).
ENGINE_IMPL=
# Twin implementation: real or stub; blank follows ENGINE_IMPL.
TWIN_IMPL=
# Graph hops of twin context each department agent sees (default 2).
CANARY_AGENT_CONTEXT_HOPS=
# Seed twin loaded when storage has no active twin (default data/synthetic_company.json).
CANARY_TWIN_SEED_PATH=
# Mitigation catalog for the seeded twin (default data/mitigations.json), e.g. data/cases/tsb-2018/mitigations.json.
CANARY_MITIGATION_CATALOG_PATH=

# App and storage
# API URL the web app calls from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
# API URL the web server calls; blank falls back to NEXT_PUBLIC_API_URL.
CANARY_API_URL=
# Blank uses files and SQLite under runs/. Supabase direct hosts are IPv6-only, so use the session pooler string: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Postgres schema for the canary_ tables (default canary; keep it out of public so the Supabase Data API cannot see it).
CANARY_DB_SCHEMA=
# Directory for run files, SQLite and the local auth key (default runs/ at the repo root).
CANARY_RUNS_DIR=

# Auth
# Shared token signing secret for deployments; if blank, a local key persists under the runs directory.
CANARY_AUTH_SECRET=
# Email for a demo approver created on startup when both demo values are set.
CANARY_DEMO_APPROVER_EMAIL=
# Password for that demo approver (at least 8 characters).
CANARY_DEMO_APPROVER_PASSWORD=

# Tests only
# Set to true to run the tests marked live_agents against the real provider (may incur usage costs).
CANARY_RUN_LIVE_TESTS=
# Postgres URL for the opt-in storage tests; they create and drop a throwaway schema.
CANARY_TEST_DATABASE_URL=
