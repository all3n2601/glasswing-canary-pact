# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Sciforium hackathon compute (OpenAI-compatible). Key handed out at Saturday compute setup.
SCIFORIUM_API_KEY=
SCIFORIUM_BASE_URL=https://api.sciforium.com/v1
# Model strings must match EXACTLY; deployment id comes from compute setup.
MODEL_DEEPSEEK=/deployments/<DEPLOYMENT_ID>/deepseek-ai/DeepSeek-V4.1-Flash
MODEL_GLM=/deployments/<DEPLOYMENT_ID>/<GLM_MODEL_STRING>
MODEL_STRONG=/deployments/<DEPLOYMENT_ID>/deepseek-ai/DeepSeek-V4.1-Flash
MODEL_FAST=/deployments/<DEPLOYMENT_ID>/deepseek-ai/DeepSeek-V4.1-Flash
LLM_MODE=replay   # replay | live | mock

# Optional BYOK fallback
OPENAI_API_KEY=

# App
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=postgresql://canary:canary@localhost:5432/canary_pact
CANARY_OFFLINE_REPLAY=true

# Auth
# Token signing secret; if blank a random one is used and tokens reset on every restart.
CANARY_AUTH_SECRET=
# Email for a demo approver created on startup when both demo values are set.
CANARY_DEMO_APPROVER_EMAIL=
# Password for that demo approver (at least 8 characters).
CANARY_DEMO_APPROVER_PASSWORD=
# Set to true to allow POST /decisions?llm_mode=live (real model calls); anything else returns 403.
CANARY_ALLOW_LIVE=

# Legacy scenario compatibility client
SCIFORIUM_API_URL=https://api.sciforium.com/v1/chat/completions
SCIFORIUM_MODEL=/deployments/<DEPLOYMENT_ID>/deepseek-ai/DeepSeek-V4.1-Flash
SCIFORIUM_TEMPERATURE=0.7
SCIFORIUM_TIMEOUT_SECONDS=30
